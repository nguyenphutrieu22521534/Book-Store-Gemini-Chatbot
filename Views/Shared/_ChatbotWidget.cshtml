<!-- BookMart Chatbot Widget -->

<!-- Toggle Button -->
<button id="chatbot-toggle" class="chatbot-toggle" aria-label="Mở chat hỗ trợ">
    <svg class="chat-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>
    </svg>
    <svg class="close-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
    </svg>
</button>

<!-- Chat Window -->
<div id="chatbot-window" class="chatbot-window">
    <!-- Header -->
    <div class="chatbot-header">
        <div class="chatbot-header-icon">📚</div>
        <div class="chatbot-header-info">
            <h4>BookMart Assistant</h4>
            <p>Sẵn sàng hỗ trợ bạn</p>
        </div>
    </div>

    <!-- Messages -->
    <div id="chatbot-messages" class="chatbot-messages">
        <div class="welcome-message">
            <h5>Xin chào! 👋</h5>
            <p>Tôi là trợ lý ảo của BookMart. Hãy hỏi tôi về sách, đơn hàng, hoặc bất cứ điều gì bạn cần!</p>
        </div>
    </div>

    <!-- Quick Suggestions -->
    <div id="chatbot-suggestions" class="chatbot-suggestions">
        <button class="suggestion-btn">🔥 Sách bán chạy</button>
        <button class="suggestion-btn">💰 Hướng dẫn thanh toán</button>
        <button class="suggestion-btn">📦 Tra cứu đơn hàng</button>
        <button class="suggestion-btn">🔄 Chính sách đổi trả</button>
    </div>

    <!-- Input -->
    <div class="chatbot-input">
        <input type="text" id="chatbot-input" placeholder="Nhập tin nhắn..." autocomplete="off">
        <button id="chatbot-send" aria-label="Gửi tin nhắn">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
        </button>
    </div>
</div>
